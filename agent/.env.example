# Copy to .env (git-ignored); run.sh loads it.

# Hosts the agent must never record against (production), comma-separated.
DEMO_BLOCKED_HOSTS=app.example.com

# Models: a pi-ai provider and model ID each (see the README's Models section).
# DEMO_PROVIDER=github-copilot
# DEMO_MODEL=gpt-6-luna
# DEMO_VISION_PROVIDER=          # defaults to DEMO_PROVIDER; must be on the OpenAI API
# DEMO_VISION_MODEL=gpt-5.6-luna
# MIDSCENE_MODEL_FAMILY=         # how the vision model reports positions, if not guessed right
# Providers without a Pi login take their usual API key variable, e.g.:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Jira: Pi's Atlassian MCP login is used when there's no API token.
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=

# PORT=4400
