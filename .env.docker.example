# Copy to .env (next to compose.yaml) for `docker compose`.

# Where Pi keeps its logins on this machine (auth.json, mcp-auth.json).
# PI_AGENT_DIR=~/.pi/agent

# The env file targets.json's "envFile" points at (the app's test username and password).
# APP_ENV_FILE=/path/to/your-app/playwright/.env

# PORT=4400
